        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <assignedTo rdf:resource="https://w3id.org/aief/Researcher"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/REAMS"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AuditLog"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/EthicsReviewBoard"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/GovernanceProcedure"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/ResponsibleReleasePolicy"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/StaffTraining"/>
        <hasRisk rdf:resource="https://w3id.org/aief/Accountability"/>
        <hasRisk rdf:resource="https://w3id.org/aief/DemocraticProcessHarm"/>
        <hasRisk rdf:resource="https://w3id.org/aief/Discrimination"/>
        <hasRisk rdf:resource="https://w3id.org/aief/GenderHarm"/>
        <hasTier rdf:resource="https://w3id.org/aief/Tier2_Reflective"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art20_EqualityBeforeLaw"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art21_NonDiscrimination"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art23_GenderEquality"/>
