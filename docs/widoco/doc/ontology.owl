        <sectionReference>NeurIPS Representation</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>Representativeness statement</requiresEvidence>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/ACM021 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/ACM021">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/ACMConference"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/EthicsReviewBoard"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/ResponsibleReleasePolicy"/>
        <hasRisk rdf:resource="https://w3id.org/aief/DualUseMisuse"/>
        <hasTier rdf:resource="https://w3id.org/aief/Tier1_Mandatory"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art41_GoodAdministration"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art47_RightToEffectiveRemedy"/>
        <isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMandatory>
        <legalBasis>NeurIPS Code of Ethics</legalBasis>
        <noteText>Charter Mapping: Art 2 Right to life; Art 3 Integrity</noteText>
        <noteText>No weapons research accepted</noteText>
        <requirementID>ACM021</requirementID>
        <requirementText>Consider whether technology can be used to harm, injure or kill people through direct application, side effects or misuse</requirementText>
        <sectionReference>NeurIPS Safety</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>Safety assessment</requiresEvidence>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/ACM022 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/ACM022">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/ACMConference"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/EthicsReviewBoard"/>
