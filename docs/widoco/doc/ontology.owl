        <noteText>Key gap — REAMS does not explicitly cover this</noteText>
        <requirementID>R085</requirementID>
        <requirementText>Have you considered anti-discrimination and bias implications of your AI/technology research?</requirementText>
        <sectionReference>General</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</tierLevel>
    </owl:NamedIndividual>
    


