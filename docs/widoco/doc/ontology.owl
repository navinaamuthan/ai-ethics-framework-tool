        <sectionReference>§2.3.2</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</tierLevel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/R082 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/R082">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/REAMS"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/EthicsReviewBoard"/>
