    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/aief/ACMConference">
        <terms:source rdf:resource="https://www.acm.org/code-of-ethics"/>
        <rdfs:comment>Research ethics and broader impact requirements from ACM, NeurIPS, FAccT, AAAI, and ACL Rolling Review conference submission guidelines.</rdfs:comment>
        <rdfs:label>ACM Conference</rdfs:label>
        <rdfs:label>ACM/NeurIPS Research Ethics Guidelines</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/AccessControl">
        <rdfs:label xml:lang="en">Access Control</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Accountability">
        <rdfs:comment>Risk that affected persons cannot obtain explanation, contestation, or remedy for AI-mediated decisions.</rdfs:comment>
        <rdfs:label>Accountability</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/AddictionRisk">
        <rdfs:comment>Risk that AI system design exploits psychological vulnerabilities to create compulsive usage patterns.</rdfs:comment>
        <rdfs:label>Addiction Risk</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Anonymisation">
        <rdfs:label xml:lang="en">Anonymisation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art11_FreedomOfExpression">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to freedom of expression. This right shall include freedom to hold opinions and to receive and impart information and ideas without interference by public authority.</rdfs:comment>
        <rdfs:label>Article 11 — Freedom of Expression</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art13_FreedomOfArtsScience">
        <rdfs:label>Article 13 — Freedom of the Arts and Sciences</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art15_FreedomOfOccupation">
        <rdfs:label>Article 15 — Freedom to Choose an Occupation and Right to Engage in Work</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art17_RightToProperty">
        <rdfs:label>Article 17 — Right to Property</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art1_HumanDignity">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Human dignity is inviolable. It must be respected and protected.</rdfs:comment>
        <rdfs:label>Article 1 — Human Dignity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art20_EqualityBeforeLaw">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone is equal before the law.</rdfs:comment>
        <rdfs:label>Article 20 — Equality Before the Law</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art21_NonDiscrimination">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Any discrimination based on any ground such as sex, race, colour, ethnic or social origin, genetic features, language, religion or belief, political or any other opinion, membership of a national minority, property, birth, disability, age or sexual orientation shall be prohibited.</rdfs:comment>
        <rdfs:label>Article 21 — Non-Discrimination</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art22_CulturalDiversity">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>The Union shall respect cultural, religious and linguistic diversity.</rdfs:comment>
        <rdfs:label>Article 22 — Cultural Diversity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art23_GenderEquality">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Equality between women and men must be ensured in all areas, including employment, work and pay.</rdfs:comment>
        <rdfs:label>Article 23 — Equality Between Women and Men</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art24_RightsOfChild">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Children shall have the right to such protection and care as is necessary for their well-being.</rdfs:comment>
        <rdfs:label>Article 24 — Rights of the Child</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art26_DisabilityIntegration">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>The Union recognises and respects the right of persons with disabilities to benefit from measures designed to ensure their independence, social and occupational integration and participation in the life of the community.</rdfs:comment>
        <rdfs:label>Article 26 — Integration of Persons with Disabilities</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art2_RightToLife">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to life.</rdfs:comment>
        <rdfs:label>Article 2 — Right to Life</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art31_FairWorkingConditions">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Every worker has the right to working conditions which respect his or her health, safety and dignity.</rdfs:comment>
        <rdfs:label>Article 31 — Fair and Just Working Conditions</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art35_HealthCare">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right of access to preventive health care and the right to benefit from medical treatment under the conditions established by national laws and practices.</rdfs:comment>
        <rdfs:label>Article 35 — Health Care</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art37_EnvironmentalProtection">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>A high level of environmental protection and the improvement of the quality of the environment must be integrated into the policies of the Union.</rdfs:comment>
        <rdfs:label>Article 37 — Environmental Protection</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art3_RightToIntegrity">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to respect for his or her physical and mental integrity.</rdfs:comment>
        <rdfs:label>Article 3 — Right to Integrity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art41_GoodAdministration">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Every person has the right to have his or her affairs handled impartially, fairly and within a reasonable time by the institutions and bodies of the Union.</rdfs:comment>
        <rdfs:label>Article 41 — Right to Good Administration</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art47_RightToEffectiveRemedy">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone whose rights and freedoms guaranteed by the law of the Union are violated has the right to an effective remedy before a tribunal.</rdfs:comment>
        <rdfs:label>Article 47 — Right to an Effective Remedy</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art48_PresumptionOfInnocence">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone who has been charged shall be presumed innocent until proved guilty according to law.</rdfs:comment>
        <rdfs:label>Article 48 — Presumption of Innocence</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art6_RightToLiberty">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to liberty and security of person.</rdfs:comment>
        <rdfs:label>Article 6 — Right to Liberty and Security</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art7_PrivateLife">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to respect for his or her private and family life, home and communications.</rdfs:comment>
        <rdfs:label>Article 7 — Respect for Private and Family Life</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Art8_DataProtection">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT"/>
        <rdfs:comment>Everyone has the right to the protection of personal data concerning him or her.</rdfs:comment>
        <rdfs:label>Article 8 — Protection of Personal Data</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/AuditLog">
        <rdfs:label xml:lang="en">Audit Log</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Certificate">
        <rdfs:comment>A formal certificate demonstrating completion of a required training or qualification.</rdfs:comment>
        <rdfs:label>Certificate</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ChildrenRights">
        <rdfs:comment>Risk of harm to children&apos;s rights, development, or best interests arising from AI systems affecting minors.</rdfs:comment>
        <rdfs:label>Children Rights</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ComplaintMechanism">
        <rdfs:label xml:lang="en">Complaint Mechanism</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ConsentForm">
        <rdfs:comment>A document through which research participants provide informed consent to participate.</rdfs:comment>
        <rdfs:label>Consent Form</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/DataBreach">
        <rdfs:comment>Risk of unauthorised access to or leakage of personal data held or processed by an AI system.</rdfs:comment>
        <rdfs:label>Data Breach</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/DataGovernance">
        <rdfs:comment>Risk arising from inadequate data stewardship, provenance, or quality controls in AI pipelines.</rdfs:comment>
        <rdfs:label>Data Governance</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/DataSubject">
        <rdfs:label xml:lang="en">Data Subject</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Deception">
        <rdfs:comment>Risk that an AI system misleads users about its nature, capabilities, or the provenance of its outputs.</rdfs:comment>
        <rdfs:label>Deception</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/DemocraticProcessHarm">
        <rdfs:comment>Risk of undermining democratic institutions, electoral processes, or civic participation through AI systems.</rdfs:comment>
        <rdfs:label>Democratic Process Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Dignity">
        <rdfs:comment>Risk of degrading, objectifying, or otherwise undermining human dignity through AI system design or use.</rdfs:comment>
        <rdfs:label>Dignity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Discrimination">
        <rdfs:comment>Risk of unfair differential treatment of individuals or groups based on protected characteristics by an AI system.</rdfs:comment>
        <rdfs:label>Discrimination</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/DualUseMisuse">
        <rdfs:comment>Risk that research or AI outputs intended for beneficial purposes are repurposed for harmful applications.</rdfs:comment>
        <rdfs:label>Dual-Use Misuse</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EUAIAct">
        <terms:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689"/>
        <rdfs:comment>Regulation (EU) 2024/1689 of the European Parliament and of the Council on Artificial Intelligence. FRIA requirements from Article 27.</rdfs:comment>
        <rdfs:label>EU AI Act</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EconomicHarm">
        <rdfs:comment>Risk of systemic or population-level economic disadvantage caused by AI systems (distinct from individual FinancialHarm).</rdfs:comment>
        <rdfs:label>Economic Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EmploymentHarm">
        <rdfs:comment>Risk of unfair exclusion, surveillance, or adverse treatment of workers or job applicants by AI systems.</rdfs:comment>
        <rdfs:label>Employment Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Encryption">
        <rdfs:label xml:lang="en">Encryption</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EnvironmentalHarm">
        <rdfs:comment>Risk of negative environmental impact including carbon footprint, resource consumption, or ecological damage from AI systems.</rdfs:comment>
        <rdfs:label>Environmental Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EnvironmentalSafeguard">
        <rdfs:label xml:lang="en">Environmental Safeguard</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/EthicsReviewBoard">
        <rdfs:label xml:lang="en">Ethics Review Board</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ExpressionHarm">
        <rdfs:comment>Risk of chilling, suppressing, or misrepresenting legitimate expression through AI content systems.</rdfs:comment>
        <rdfs:label>Expression Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/FalseIdentification">
        <rdfs:comment>Risk of incorrect identity attribution (e.g. facial-recognition false matches) with consequential harm.</rdfs:comment>
        <rdfs:label>False Identification</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/FinancialHarm">
        <rdfs:comment>Risk of economic loss, fraudulent debt, or material deprivation caused by an AI system.</rdfs:comment>
        <rdfs:label>Financial Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/FunctionCreep">
        <rdfs:comment>Risk that an AI system is used beyond its originally defined and ethically approved purpose.</rdfs:comment>
        <rdfs:label>Function Creep</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/GenderHarm">
        <rdfs:comment>Risk of gender-based disadvantage, stereotyping, or exclusion produced or amplified by an AI system.</rdfs:comment>
        <rdfs:label>Gender Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/GovernanceProcedure">
        <rdfs:label xml:lang="en">Governance Procedure</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/HorizonEurope">
        <terms:source rdf:resource="https://ec.europa.eu/info/funding-tenders/opportunities/docs/2021-2027/horizon/guidance/ethics-appraisal-procedure_he_en.pdf"/>
        <rdfs:comment>European Commission ethics requirements for Horizon Europe funded research projects.</rdfs:comment>
        <rdfs:label>Horizon Europe</rdfs:label>
        <rdfs:label>Horizon Europe Ethics Guidelines</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/HumanOversight">
        <rdfs:label xml:lang="en">Human Oversight</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/IncidentResponsePlan">
        <rdfs:label xml:lang="en">Incident Response Plan</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/IntellectualProperty">
        <rdfs:comment>Risk of unauthorised use or infringement of intellectual property in AI training or outputs.</rdfs:comment>
        <rdfs:label>Intellectual Property</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/LibertyViolation">
        <rdfs:comment>Risk of unjustified restriction of personal liberty through AI-informed decisions (detention, exclusion, coercion).</rdfs:comment>
        <rdfs:label>Liberty Violation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Manipulation">
        <rdfs:comment>Risk that an AI system covertly influences behaviour, beliefs, or choices without adequate disclosure or consent.</rdfs:comment>
        <rdfs:label>Manipulation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/PersonalData">
        <rdfs:label xml:lang="en">Personal Data</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/PhysicalHarm">
        <rdfs:comment>Risk of bodily injury, death, or physical safety compromise caused by an AI system.</rdfs:comment>
        <rdfs:label>Physical Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/PrivacyBreach">
        <rdfs:comment>Risk of unauthorised collection, processing, or disclosure of personal data by an AI system.</rdfs:comment>
        <rdfs:label>Privacy Breach</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Pseudonymisation">
        <rdfs:label xml:lang="en">Pseudonymisation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/PsychologicalHarm">
        <rdfs:comment>Risk of mental distress, manipulation, coercion, or emotional damage caused by an AI system.</rdfs:comment>
        <rdfs:label>Psychological Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/REAMS">
        <terms:source rdf:resource="https://www.tcd.ie/research/ethics/"/>
        <rdfs:comment>Trinity College Dublin Research Ethics Application Management System. Institutional ethics framework for research approval.</rdfs:comment>
        <rdfs:label>TCD REAMS</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ReputationalHarm">
        <rdfs:comment>Risk of damage to an individual&apos;s or organisation&apos;s reputation through AI-generated outputs or decisions.</rdfs:comment>
        <rdfs:label>Reputational Harm</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Researcher">
        <rdfs:label xml:lang="en">Researcher</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/ResponsibleReleasePolicy">
        <rdfs:label xml:lang="en">Responsible Release Policy</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/StaffTraining">
        <rdfs:label xml:lang="en">Staff Training</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Surveillance">
        <rdfs:comment>Risk of pervasive or disproportionate observation, tracking, or monitoring of individuals by an AI system.</rdfs:comment>
        <rdfs:label>Surveillance</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Tier1_Mandatory">
        <rdfs:comment>Requirements that apply to all research proposals regardless of context. Failure to comply blocks ethics approval.</rdfs:comment>
        <rdfs:label>Tier 1 — Mandatory</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Tier2_Reflective">
        <rdfs:comment>Requirements that apply conditionally based on research context. Researchers must reflect on whether these apply to their specific project.</rdfs:comment>
        <rdfs:label>Tier 2 — Reflective</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/Transparency">
        <rdfs:comment>Risk that an AI system&apos;s operation, capabilities, limitations, or decision rationale are not adequately disclosed to end-users and stakeholders.</rdfs:comment>
        <rdfs:label>Transparency</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/WorkplaceSafetyRisk">
        <rdfs:comment>Risk of harm to workers arising from AI system deployment in occupational settings.</rdfs:comment>
        <rdfs:label>Workplace Safety Risk</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/aief/requiresEvidence">
        <rdfs:label>requires evidence</rdfs:label>
    </rdf:Description>
</rdf:RDF>



