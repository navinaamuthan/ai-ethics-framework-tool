        <requirementID>ACM015</requirementID>
        <requirementText>Research involving human participants must follow existing institutional protocols (IRB or equivalent) — if no formal process exists, undergo equivalent informal ethics review</requirementText>
        <sectionReference>NeurIPS Human Subjects</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>IRB/ethics approval or peer review</requiresEvidence>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/ACM016 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/ACM016">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/ACMConference"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AccessControl"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AuditLog"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/Encryption"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/GovernanceProcedure"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/Pseudonymisation"/>
        <hasRisk rdf:resource="https://w3id.org/aief/DataGovernance"/>
        <hasRisk rdf:resource="https://w3id.org/aief/PrivacyBreach"/>
        <hasTier rdf:resource="https://w3id.org/aief/Tier1_Mandatory"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art41_GoodAdministration"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art8_DataProtection"/>
        <isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMandatory>
        <legalBasis>NeurIPS Code of Ethics</legalBasis>
        <noteText>Charter Mapping: Art 7 Private life; Art 8 Data protection</noteText>
        <requirementID>ACM016</requirementID>
        <requirementText>Datasets should minimise exposure of personally identifiable information unless informed consent is provided</requirementText>
        <sectionReference>NeurIPS Privacy</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>Data anonymisation documentation</requiresEvidence>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/ACM017 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/ACM017">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/ACMConference"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AuditLog"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/GovernanceProcedure"/>
        <hasRisk rdf:resource="https://w3id.org/aief/DataGovernance"/>
        <hasTier rdf:resource="https://w3id.org/aief/Tier1_Mandatory"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art41_GoodAdministration"/>
        <mapsToRight rdf:resource="https://w3id.org/aief/Art47_RightToEffectiveRemedy"/>
        <isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMandatory>
        <legalBasis>NeurIPS Code of Ethics</legalBasis>
        <noteText>Charter Mapping: Art 8 Data protection</noteText>
        <requirementID>ACM017</requirementID>
        <requirementText>Datasets with real data of real people must have explicit consent of participants, or explain why consent was not obtained</requirementText>
        <sectionReference>NeurIPS Consent</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>Consent documentation</requiresEvidence>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aief/ACM018 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/ACM018">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/ACMConference"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AuditLog"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/GovernanceProcedure"/>
        <hasRisk rdf:resource="https://w3id.org/aief/DataGovernance"/>
        <hasRisk rdf:resource="https://w3id.org/aief/IntellectualProperty"/>
