    <!-- https://w3id.org/aief/R080 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aief/R080">
        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/REAMS"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/EthicsReviewBoard"/>
