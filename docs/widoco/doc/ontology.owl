    <!-- https://w3id.org/aief/appliesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aief/appliesTo">
        <rdfs:domain rdf:resource="https://w3id.org/aief/Requirement"/>
        <rdfs:range rdf:resource="https://w3id.org/aief/Stakeholder"/>
        <rdfs:label>applies to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aief/assignedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aief/assignedTo">
        <rdfs:domain rdf:resource="https://w3id.org/aief/Requirement"/>
        <rdfs:range rdf:resource="https://w3id.org/aief/Stakeholder"/>
        <rdfs:label>assigned to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aief/belongsToFramework -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aief/belongsToFramework">
        <owl:inverseOf rdf:resource="https://w3id.org/aief/hasRequirement"/>
        <rdfs:domain rdf:resource="https://w3id.org/aief/Requirement"/>
        <rdfs:range rdf:resource="https://w3id.org/aief/Framework"/>
        <rdfs:label>belongs to framework</rdfs:label>
    </owl:ObjectProperty>
    


