        <mapsToRight rdf:resource="https://w3id.org/aief/Art8_DataProtection"/>
        <isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMandatory>
        <legalBasis>NeurIPS Code of Ethics</legalBasis>
        <requirementID>ACM022</requirementID>
        <requirementText>Consider risk that applications could open security vulnerabilities or cause serious accidents — recommend or implement protections</requirementText>
        <sectionReference>NeurIPS Security</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
        <requiresEvidence>Security risk assessment</requiresEvidence>
    </owl:NamedIndividual>
    


