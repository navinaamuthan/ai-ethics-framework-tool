        <noteText>Charter Mapping: Art 17 Right to property</noteText>
        <requirementID>ACM019</requirementID>
        <requirementText>Respect terms of datasets with defined licences (CC 4.0, MIT etc)</requirementText>
        <sectionReference>NeurIPS Copyright</sectionReference>
        <tierLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tierLevel>
