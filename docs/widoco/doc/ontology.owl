<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/aief/"
     xml:base="https://w3id.org/aief/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:aief="https://w3id.org/aief/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/aief/">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</terms:created>
        <terms:creator>Navina Ganapathy Amuthan</terms:creator>
        <terms:description xml:lang="en">An OWL ontology and RDF knowledge graph harmonising 207 governance requirements drawn from the TCD REAMS research-ethics process, the EU AI Act, Horizon Europe ethics guidance, and the ACM/NeurIPS professional codes, mapped to the EU Charter of Fundamental Rights and linked to documented AI-incident precedents. Developed as part of an MSc dissertation at Trinity College Dublin.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-06</terms:modified>
        <terms:title xml:lang="en">AI Ethics Assessment Framework (AIEF) Ontology</terms:title>
        <rdfs:comment xml:lang="en">Ontology for multi-framework AI ethics compliance assessment</rdfs:comment>
        <rdfs:label xml:lang="en">AI-Assisted Ethics Assessment Framework</rdfs:label>
        <owl:versionInfo>2.1.2</owl:versionInfo>
    </owl:Ontology>
    


