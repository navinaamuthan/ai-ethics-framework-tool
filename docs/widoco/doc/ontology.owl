        <rdf:type rdf:resource="https://w3id.org/aief/Obligation"/>
        <belongsToFramework rdf:resource="https://w3id.org/aief/REAMS"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/AccessControl"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/Encryption"/>
        <hasMitigation rdf:resource="https://w3id.org/aief/Pseudonymisation"/>
