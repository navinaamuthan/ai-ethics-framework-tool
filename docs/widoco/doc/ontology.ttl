###  https://w3id.org/aief/AssessmentProcess
:AssessmentProcess rdf:type owl:Class ;
                   rdfs:comment "A formal procedure for evaluating ethics compliance, risk, or impact of a research project or AI system." ;
                   rdfs:label "Assessment Process" .


###  https://w3id.org/aief/AuditLog
:AuditLog rdf:type owl:Class ;
          rdfs:subClassOf :TechnicalMeasure .


###  https://w3id.org/aief/BiasAssessment
:BiasAssessment rdf:type owl:Class ;
                rdfs:subClassOf :AssessmentProcess ;
                rdfs:comment "A systematic evaluation of bias in AI training data, model outputs, or decision processes." ;
                rdfs:label "Bias Assessment" .


###  https://w3id.org/aief/BiasAssessmentReport
:BiasAssessmentReport rdf:type owl:Class ;
                      rdfs:subClassOf :Evidence ;
                      rdfs:comment "A document evaluating the presence and extent of bias in an AI system's training data or outputs." ;
                      rdfs:label "Bias Assessment Report" .


###  https://w3id.org/aief/Certificate
:Certificate rdf:type owl:Class ;
