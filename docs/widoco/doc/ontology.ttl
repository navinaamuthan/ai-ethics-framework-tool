#################################################################
#    Annotations
#################################################################

:ACMConference <http://purl.org/dc/terms/source> <https://www.acm.org/code-of-ethics> ;
               rdfs:comment "Research ethics and broader impact requirements from ACM, NeurIPS, FAccT, AAAI, and ACL Rolling Review conference submission guidelines." ;
               rdfs:label "ACM Conference" ,
                          "ACM/NeurIPS Research Ethics Guidelines" .


:AccessControl rdfs:label "Access Control"@en .


:Accountability rdfs:comment "Risk that affected persons cannot obtain explanation, contestation, or remedy for AI-mediated decisions." ;
                rdfs:label "Accountability" .


:AddictionRisk rdfs:comment "Risk that AI system design exploits psychological vulnerabilities to create compulsive usage patterns." ;
               rdfs:label "Addiction Risk" .


:Anonymisation rdfs:label "Anonymisation"@en .


:Art11_FreedomOfExpression <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                           rdfs:comment "Everyone has the right to freedom of expression. This right shall include freedom to hold opinions and to receive and impart information and ideas without interference by public authority." ;
                           rdfs:label "Article 11 — Freedom of Expression" .


:Art13_FreedomOfArtsScience rdfs:label "Article 13 — Freedom of the Arts and Sciences" .


:Art15_FreedomOfOccupation rdfs:label "Article 15 — Freedom to Choose an Occupation and Right to Engage in Work" .


:Art17_RightToProperty rdfs:label "Article 17 — Right to Property" .


:Art1_HumanDignity <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                   rdfs:comment "Human dignity is inviolable. It must be respected and protected." ;
                   rdfs:label "Article 1 — Human Dignity" .


:Art20_EqualityBeforeLaw <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                         rdfs:comment "Everyone is equal before the law." ;
                         rdfs:label "Article 20 — Equality Before the Law" .


:Art21_NonDiscrimination <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                         rdfs:comment "Any discrimination based on any ground such as sex, race, colour, ethnic or social origin, genetic features, language, religion or belief, political or any other opinion, membership of a national minority, property, birth, disability, age or sexual orientation shall be prohibited." ;
                         rdfs:label "Article 21 — Non-Discrimination" .


:Art22_CulturalDiversity <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                         rdfs:comment "The Union shall respect cultural, religious and linguistic diversity." ;
                         rdfs:label "Article 22 — Cultural Diversity" .


:Art23_GenderEquality <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                      rdfs:comment "Equality between women and men must be ensured in all areas, including employment, work and pay." ;
                      rdfs:label "Article 23 — Equality Between Women and Men" .


:Art24_RightsOfChild <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                     rdfs:comment "Children shall have the right to such protection and care as is necessary for their well-being." ;
                     rdfs:label "Article 24 — Rights of the Child" .


:Art26_DisabilityIntegration <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                             rdfs:comment "The Union recognises and respects the right of persons with disabilities to benefit from measures designed to ensure their independence, social and occupational integration and participation in the life of the community." ;
                             rdfs:label "Article 26 — Integration of Persons with Disabilities" .


:Art2_RightToLife <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                  rdfs:comment "Everyone has the right to life." ;
                  rdfs:label "Article 2 — Right to Life" .


:Art31_FairWorkingConditions <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                             rdfs:comment "Every worker has the right to working conditions which respect his or her health, safety and dignity." ;
                             rdfs:label "Article 31 — Fair and Just Working Conditions" .


:Art35_HealthCare <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                  rdfs:comment "Everyone has the right of access to preventive health care and the right to benefit from medical treatment under the conditions established by national laws and practices." ;
                  rdfs:label "Article 35 — Health Care" .


:Art37_EnvironmentalProtection <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                               rdfs:comment "A high level of environmental protection and the improvement of the quality of the environment must be integrated into the policies of the Union." ;
                               rdfs:label "Article 37 — Environmental Protection" .


:Art3_RightToIntegrity <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                       rdfs:comment "Everyone has the right to respect for his or her physical and mental integrity." ;
                       rdfs:label "Article 3 — Right to Integrity" .


:Art41_GoodAdministration <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                          rdfs:comment "Every person has the right to have his or her affairs handled impartially, fairly and within a reasonable time by the institutions and bodies of the Union." ;
                          rdfs:label "Article 41 — Right to Good Administration" .


:Art47_RightToEffectiveRemedy <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                              rdfs:comment "Everyone whose rights and freedoms guaranteed by the law of the Union are violated has the right to an effective remedy before a tribunal." ;
                              rdfs:label "Article 47 — Right to an Effective Remedy" .


:Art48_PresumptionOfInnocence <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                              rdfs:comment "Everyone who has been charged shall be presumed innocent until proved guilty according to law." ;
                              rdfs:label "Article 48 — Presumption of Innocence" .


:Art6_RightToLiberty <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                     rdfs:comment "Everyone has the right to liberty and security of person." ;
                     rdfs:label "Article 6 — Right to Liberty and Security" .


:Art7_PrivateLife <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                  rdfs:comment "Everyone has the right to respect for his or her private and family life, home and communications." ;
                  rdfs:label "Article 7 — Respect for Private and Family Life" .


:Art8_DataProtection <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                     rdfs:comment "Everyone has the right to the protection of personal data concerning him or her." ;
                     rdfs:label "Article 8 — Protection of Personal Data" .


:AuditLog rdfs:label "Audit Log"@en .


:Certificate rdfs:comment "A formal certificate demonstrating completion of a required training or qualification." ;
             rdfs:label "Certificate" .


:ChildrenRights rdfs:comment "Risk of harm to children's rights, development, or best interests arising from AI systems affecting minors." ;
                rdfs:label "Children Rights" .


:ComplaintMechanism rdfs:label "Complaint Mechanism"@en .


:ConsentForm rdfs:comment "A document through which research participants provide informed consent to participate." ;
             rdfs:label "Consent Form" .


:DataBreach rdfs:comment "Risk of unauthorised access to or leakage of personal data held or processed by an AI system." ;
            rdfs:label "Data Breach" .


:DataGovernance rdfs:comment "Risk arising from inadequate data stewardship, provenance, or quality controls in AI pipelines." ;
                rdfs:label "Data Governance" .


:DataSubject rdfs:label "Data Subject"@en .


:Deception rdfs:comment "Risk that an AI system misleads users about its nature, capabilities, or the provenance of its outputs." ;
           rdfs:label "Deception" .


:DemocraticProcessHarm rdfs:comment "Risk of undermining democratic institutions, electoral processes, or civic participation through AI systems." ;
                       rdfs:label "Democratic Process Harm" .


:Dignity rdfs:comment "Risk of degrading, objectifying, or otherwise undermining human dignity through AI system design or use." ;
         rdfs:label "Dignity" .


:Discrimination rdfs:comment "Risk of unfair differential treatment of individuals or groups based on protected characteristics by an AI system." ;
                rdfs:label "Discrimination" .


:DualUseMisuse rdfs:comment "Risk that research or AI outputs intended for beneficial purposes are repurposed for harmful applications." ;
               rdfs:label "Dual-Use Misuse" .


:EUAIAct <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
         rdfs:comment "Regulation (EU) 2024/1689 of the European Parliament and of the Council on Artificial Intelligence. FRIA requirements from Article 27." ;
         rdfs:label "EU AI Act" .


:EconomicHarm rdfs:comment "Risk of systemic or population-level economic disadvantage caused by AI systems (distinct from individual FinancialHarm)." ;
              rdfs:label "Economic Harm" .


:EmploymentHarm rdfs:comment "Risk of unfair exclusion, surveillance, or adverse treatment of workers or job applicants by AI systems." ;
                rdfs:label "Employment Harm" .


:Encryption rdfs:label "Encryption"@en .


:EnvironmentalHarm rdfs:comment "Risk of negative environmental impact including carbon footprint, resource consumption, or ecological damage from AI systems." ;
                   rdfs:label "Environmental Harm" .


:EnvironmentalSafeguard rdfs:label "Environmental Safeguard"@en .


:EthicsReviewBoard rdfs:label "Ethics Review Board"@en .


:ExpressionHarm rdfs:comment "Risk of chilling, suppressing, or misrepresenting legitimate expression through AI content systems." ;
                rdfs:label "Expression Harm" .


:FalseIdentification rdfs:comment "Risk of incorrect identity attribution (e.g. facial-recognition false matches) with consequential harm." ;
                     rdfs:label "False Identification" .


:FinancialHarm rdfs:comment "Risk of economic loss, fraudulent debt, or material deprivation caused by an AI system." ;
               rdfs:label "Financial Harm" .


:FunctionCreep rdfs:comment "Risk that an AI system is used beyond its originally defined and ethically approved purpose." ;
               rdfs:label "Function Creep" .


:GenderHarm rdfs:comment "Risk of gender-based disadvantage, stereotyping, or exclusion produced or amplified by an AI system." ;
            rdfs:label "Gender Harm" .


:GovernanceProcedure rdfs:label "Governance Procedure"@en .


:HorizonEurope <http://purl.org/dc/terms/source> <https://ec.europa.eu/info/funding-tenders/opportunities/docs/2021-2027/horizon/guidance/ethics-appraisal-procedure_he_en.pdf> ;
               rdfs:comment "European Commission ethics requirements for Horizon Europe funded research projects." ;
               rdfs:label "Horizon Europe" ,
                          "Horizon Europe Ethics Guidelines" .


:HumanOversight rdfs:label "Human Oversight"@en .


:IncidentResponsePlan rdfs:label "Incident Response Plan"@en .


:IntellectualProperty rdfs:comment "Risk of unauthorised use or infringement of intellectual property in AI training or outputs." ;
                      rdfs:label "Intellectual Property" .


:LibertyViolation rdfs:comment "Risk of unjustified restriction of personal liberty through AI-informed decisions (detention, exclusion, coercion)." ;
                  rdfs:label "Liberty Violation" .


:Manipulation rdfs:comment "Risk that an AI system covertly influences behaviour, beliefs, or choices without adequate disclosure or consent." ;
              rdfs:label "Manipulation" .


:PersonalData rdfs:label "Personal Data"@en .


:PhysicalHarm rdfs:comment "Risk of bodily injury, death, or physical safety compromise caused by an AI system." ;
              rdfs:label "Physical Harm" .


:PrivacyBreach rdfs:comment "Risk of unauthorised collection, processing, or disclosure of personal data by an AI system." ;
               rdfs:label "Privacy Breach" .


:Pseudonymisation rdfs:label "Pseudonymisation"@en .


:PsychologicalHarm rdfs:comment "Risk of mental distress, manipulation, coercion, or emotional damage caused by an AI system." ;
                   rdfs:label "Psychological Harm" .


:REAMS <http://purl.org/dc/terms/source> <https://www.tcd.ie/research/ethics/> ;
       rdfs:comment "Trinity College Dublin Research Ethics Application Management System. Institutional ethics framework for research approval." ;
       rdfs:label "TCD REAMS" .


:ReputationalHarm rdfs:comment "Risk of damage to an individual's or organisation's reputation through AI-generated outputs or decisions." ;
                  rdfs:label "Reputational Harm" .


:Researcher rdfs:label "Researcher"@en .


:ResponsibleReleasePolicy rdfs:label "Responsible Release Policy"@en .


:StaffTraining rdfs:label "Staff Training"@en .


:Surveillance rdfs:comment "Risk of pervasive or disproportionate observation, tracking, or monitoring of individuals by an AI system." ;
              rdfs:label "Surveillance" .


:Tier1_Mandatory rdfs:comment "Requirements that apply to all research proposals regardless of context. Failure to comply blocks ethics approval." ;
                 rdfs:label "Tier 1 — Mandatory" .


:Tier2_Reflective rdfs:comment "Requirements that apply conditionally based on research context. Researchers must reflect on whether these apply to their specific project." ;
                  rdfs:label "Tier 2 — Reflective" .


:Transparency rdfs:comment "Risk that an AI system's operation, capabilities, limitations, or decision rationale are not adequately disclosed to end-users and stakeholders." ;
              rdfs:label "Transparency" .


:WorkplaceSafetyRisk rdfs:comment "Risk of harm to workers arising from AI system deployment in occupational settings." ;
                     rdfs:label "Workplace Safety Risk" .


:requiresEvidence rdfs:label "requires evidence" .


