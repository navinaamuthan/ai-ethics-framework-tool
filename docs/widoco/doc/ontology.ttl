<https://w3c-cg.github.io/dpv/2.3/legal/eu/rights#RightsOfChild> rdf:type owl:Class ;
                                                                 owl:equivalentClass :Art24_RightsOfChild .


###  https://w3id.org/aief/AAAI
:AAAI rdf:type owl:Class ;
      rdfs:subClassOf :ACMConference ;
      rdfs:label "AAAI" .


###  https://w3id.org/aief/ACLRollingReview
:ACLRollingReview rdf:type owl:Class ;
                  rdfs:subClassOf :ACMConference ;
                  rdfs:label "ACL Rolling Review" .


###  https://w3id.org/aief/ACMConference
:ACMConference rdf:type owl:Class ;
               rdfs:subClassOf :Framework .


