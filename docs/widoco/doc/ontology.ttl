###  https://w3id.org/aief/R010
:R010 rdf:type owl:NamedIndividual ,
               :Obligation ;
      :assignedTo :Researcher ;
      :belongsToFramework :REAMS ;
      :hasMitigation :AuditLog ,
                     :ComplaintMechanism ,
                     :EthicsReviewBoard ,
                     :GovernanceProcedure ,
                     :HumanOversight ,
                     :ResponsibleReleasePolicy ,
                     :StaffTraining ;
      :hasRisk :Accountability ,
               :Dignity ,
               :DualUseMisuse ,
               :EconomicHarm ,
               :FinancialHarm ,
               :LibertyViolation ,
               :PsychologicalHarm ;
      :hasTier :Tier1_Mandatory ;
      :mapsToRight :Art1_HumanDignity ,
                   :Art47_RightToEffectiveRemedy ;
      :isMandatory "true"^^xsd:boolean ;
      :requirementID "R010" ;
      :requirementText "Assess whether research could have detrimental legal, economic or social consequences for participants" ;
      :sectionReference "REAMS §2.3.1" ;
      :tierLevel 1 ;
      :triggersReviewLevel "Level 3" .


###  https://w3id.org/aief/R011
