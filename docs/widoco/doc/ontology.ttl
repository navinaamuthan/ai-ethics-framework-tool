                rdfs:label "Anonymised Data"@en .


###  https://w3id.org/aief/Art10_FreedomOfThought
:Art10_FreedomOfThought rdf:type owl:Class ;
                        rdfs:subClassOf :Title2_Freedoms ;
                        <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                        rdfs:comment "Everyone has the right to freedom of thought, conscience and religion." ;
                        rdfs:label "Article 10 — Freedom of Thought" .


###  https://w3id.org/aief/Art11_FreedomOfExpression
:Art11_FreedomOfExpression rdf:type owl:Class ;
                           rdfs:subClassOf :Title2_Freedoms .


###  https://w3id.org/aief/Art12_FreedomOfAssembly
:Art12_FreedomOfAssembly rdf:type owl:Class ;
                         rdfs:subClassOf :Title2_Freedoms ;
                         <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                         rdfs:comment "Everyone has the right to freedom of peaceful assembly and to freedom of association at all levels, in particular in political, trade union and civic matters, which includes the right of everyone to form and to join trade unions for the protection of his or her interests." ;
                         rdfs:label "Article 12 — Freedom of Assembly and of Association" .


###  https://w3id.org/aief/Art13_FreedomOfArtsScience
:Art13_FreedomOfArtsScience rdf:type owl:Class ;
                            rdfs:subClassOf :Title2_Freedoms .


