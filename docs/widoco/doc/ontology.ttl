:Art16_FreedomToConductBusiness rdf:type owl:Class ;
                                rdfs:subClassOf :Title2_Freedoms ;
                                <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:12016P/TXT> ;
                                rdfs:comment "The freedom to conduct a business in accordance with Union law and national laws and practices is recognised." ;
                                rdfs:label "Article 16 — Freedom to Conduct a Business" .


