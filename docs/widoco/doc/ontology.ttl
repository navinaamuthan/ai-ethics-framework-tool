###  https://w3id.org/aief/HE006
:HE006 rdf:type owl:NamedIndividual ,
                :Obligation ;
       :belongsToFramework :HorizonEurope ;
       :hasMitigation :AuditLog ,
                      :EthicsReviewBoard ,
                      :GovernanceProcedure ,
                      :StaffTraining ;
