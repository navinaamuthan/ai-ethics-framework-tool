@prefix : <https://w3id.org/aief/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/aief/> .

<https://w3id.org/aief/> rdf:type owl:Ontology ;
                          <http://purl.org/dc/terms/created> "2026-06-26"^^xsd:date ;
                          <http://purl.org/dc/terms/creator> "Navina Ganapathy Amuthan" ;
                          <http://purl.org/dc/terms/description> "An OWL ontology and RDF knowledge graph harmonising 207 governance requirements drawn from the TCD REAMS research-ethics process, the EU AI Act, Horizon Europe ethics guidance, and the ACM/NeurIPS professional codes, mapped to the EU Charter of Fundamental Rights and linked to documented AI-incident precedents. Developed as part of an MSc dissertation at Trinity College Dublin."@en ;
                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                          <http://purl.org/dc/terms/modified> "2026-08-06"^^xsd:date ;
                          <http://purl.org/dc/terms/title> "AI Ethics Assessment Framework (AIEF) Ontology"@en ;
                          rdfs:comment "Ontology for multi-framework AI ethics compliance assessment"@en ;
                          rdfs:label "AI-Assisted Ethics Assessment Framework"@en ;
                          owl:versionInfo "2.1.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/aief/appliesTo
:appliesTo rdf:type owl:ObjectProperty ;
           rdfs:domain :Requirement ;
           rdfs:range :Stakeholder ;
           rdfs:label "applies to" .


###  https://w3id.org/aief/assignedTo
:assignedTo rdf:type owl:ObjectProperty ;
            rdfs:domain :Requirement ;
            rdfs:range :Stakeholder ;
            rdfs:label "assigned to" .


###  https://w3id.org/aief/belongsToFramework
:belongsToFramework rdf:type owl:ObjectProperty ;
                    owl:inverseOf :hasRequirement ;
                    rdfs:domain :Requirement ;
                    rdfs:range :Framework ;
                    rdfs:label "belongs to framework" .


###  https://w3id.org/aief/complementedBy
:complementedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :AssessmentProcess ;
                rdfs:range :AssessmentProcess ;
                rdfs:label "complemented by" .


###  https://w3id.org/aief/demonstratesRisk
:demonstratesRisk rdf:type owl:ObjectProperty ;
                  rdfs:domain :Incident ;
                  rdfs:range :RiskCategory ;
                  rdfs:label "demonstrates risk"@en .


###  https://w3id.org/aief/hasAssessmentProcess
:hasAssessmentProcess rdf:type owl:ObjectProperty ;
                      rdfs:domain :Framework ;
                      rdfs:range :AssessmentProcess ;
                      rdfs:label "has assessment process" .


###  https://w3id.org/aief/hasComplianceStatus
:hasComplianceStatus rdf:type owl:ObjectProperty ;
                     rdfs:domain :Requirement ;
                     rdfs:range :ComplianceStatus ;
                     rdfs:label "has compliance status" .


###  https://w3id.org/aief/hasEvidence
:hasEvidence rdf:type owl:ObjectProperty ;
             rdfs:domain :Requirement ;
             rdfs:range :Evidence ;
             rdfs:label "has evidence" .


###  https://w3id.org/aief/hasImpactOn
:hasImpactOn rdf:type owl:ObjectProperty ;
             rdfs:domain :RiskCategory ;
             rdfs:range :EUCharterRight ;
             rdfs:label "has impact on" .


###  https://w3id.org/aief/hasMitigation
:hasMitigation rdf:type owl:ObjectProperty ;
               rdfs:domain :RiskCategory ;
               rdfs:range :Mitigation ;
               rdfs:label "has mitigation" .


###  https://w3id.org/aief/hasRequirement
:hasRequirement rdf:type owl:ObjectProperty ;
                rdfs:domain :Framework ;
                rdfs:range :Requirement ;
                rdfs:label "has requirement" .


###  https://w3id.org/aief/hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain :Requirement ;
         rdfs:range :RiskCategory ;
         rdfs:label "has risk" .


###  https://w3id.org/aief/hasStakeholder
:hasStakeholder rdf:type owl:ObjectProperty ;
                rdfs:domain :Requirement ;
                rdfs:range :Stakeholder ;
                rdfs:label "has stakeholder" .


###  https://w3id.org/aief/hasTier
:hasTier rdf:type owl:ObjectProperty ;
         rdfs:domain :Requirement ;
         rdfs:range :Tier ;
         rdfs:label "has tier" .


###  https://w3id.org/aief/impactsRight
:impactsRight rdf:type owl:ObjectProperty ;
              rdfs:domain :Incident ;
              rdfs:range :EUCharterRight ;
              rdfs:label "impacts right"@en .


###  https://w3id.org/aief/involvesData
:involvesData rdf:type owl:ObjectProperty ;
              rdfs:domain :Requirement ;
              rdfs:range :DataCategory ;
              rdfs:label "involves data" .


###  https://w3id.org/aief/isRelatedTo
:isRelatedTo rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :Requirement ;
             rdfs:range :Requirement ;
             rdfs:label "is related to" .


###  https://w3id.org/aief/mapsToRight
:mapsToRight rdf:type owl:ObjectProperty ;
             rdfs:domain :Requirement ;
             rdfs:range :EUCharterRight ;
             rdfs:label "maps to EU Charter right" .


###  https://w3id.org/aief/mitigatedBy
:mitigatedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :mitigates ;
             rdfs:domain :RiskCategory ;
             rdfs:range :Mitigation ;
             rdfs:label "mitigated by" .


###  https://w3id.org/aief/mitigates
:mitigates rdf:type owl:ObjectProperty ;
           rdfs:domain :Mitigation ;
           rdfs:range :RiskCategory ;
           rdfs:label "mitigates" .


###  https://w3id.org/aief/requiresEvidence
:requiresEvidence rdf:type owl:ObjectProperty ;
                  rdfs:domain :Requirement ;
                  rdfs:range :Evidence .


###  https://w3id.org/aief/supportsRequirement
:supportsRequirement rdf:type owl:ObjectProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range :Requirement ;
                     rdfs:label "supports requirement"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/aief/aiCapability
:aiCapability rdf:type owl:DatatypeProperty ;
              rdfs:label "AI capability"@en .


###  https://w3id.org/aief/coderAgreement
:coderAgreement rdf:type owl:DatatypeProperty ;
                rdfs:label "coder agreement"@en .


###  https://w3id.org/aief/dateExtracted
:dateExtracted rdf:type owl:DatatypeProperty ;
               rdfs:domain :Requirement ;
               rdfs:range xsd:dateTime ;
               rdfs:label "date extracted" .


###  https://w3id.org/aief/evidenceDescription
:evidenceDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Evidence ;
                     rdfs:range xsd:string ;
                     rdfs:label "evidence description" .


###  https://w3id.org/aief/frameworkVersion
:frameworkVersion rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Framework ;
                  rdfs:range xsd:string ;
                  rdfs:label "framework version" .


###  https://w3id.org/aief/incidentID
:incidentID rdf:type owl:DatatypeProperty ;
            rdfs:label "incident ID"@en .


###  https://w3id.org/aief/incidentTitle
:incidentTitle rdf:type owl:DatatypeProperty ;
               rdfs:label "incident title"@en .


###  https://w3id.org/aief/incidentYear
:incidentYear rdf:type owl:DatatypeProperty ;
              rdfs:label "incident year"@en .


###  https://w3id.org/aief/isMandatory
:isMandatory rdf:type owl:DatatypeProperty ;
             rdfs:domain :Requirement ;
             rdfs:range xsd:boolean ;
             rdfs:label "is mandatory" .


###  https://w3id.org/aief/legalBasis
:legalBasis rdf:type owl:DatatypeProperty ;
            rdfs:domain :Requirement ;
            rdfs:range xsd:string ;
            rdfs:label "legal basis" .


###  https://w3id.org/aief/noteText
:noteText rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:label "note text" .


###  https://w3id.org/aief/requirementID
:requirementID rdf:type owl:DatatypeProperty ;
               rdfs:domain :Requirement ;
               rdfs:range xsd:string ;
               rdfs:label "requirement ID" .


###  https://w3id.org/aief/requirementText
:requirementText rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Requirement ;
                 rdfs:range xsd:string ;
                 rdfs:label "requirement text" .


###  https://w3id.org/aief/sectionReference
:sectionReference rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Requirement ;
                  rdfs:range xsd:string ;
                  rdfs:label "section reference" .


###  https://w3id.org/aief/tierLevel
:tierLevel rdf:type owl:DatatypeProperty ;
           rdfs:domain :Requirement ;
           rdfs:range xsd:integer ;
           rdfs:label "tier level" .


###  https://w3id.org/aief/triggersReviewLevel
:triggersReviewLevel rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Requirement ;
                     rdfs:range xsd:string ;
                     rdfs:label "triggers review level" .


