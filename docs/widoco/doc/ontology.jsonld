}, {
  "@id" : "https://w3id.org/aief/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-06-26"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Navina Ganapathy Amuthan"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "An OWL ontology and RDF knowledge graph harmonising 207 governance requirements drawn from the TCD REAMS research-ethics process, the EU AI Act, Horizon Europe ethics guidance, and the ACM/NeurIPS professional codes, mapped to the EU Charter of Fundamental Rights and linked to documented AI-incident precedents. Developed as part of an MSc dissertation at Trinity College Dublin."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-06"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "AI Ethics Assessment Framework (AIEF) Ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Ontology for multi-framework AI ethics compliance assessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AI-Assisted Ethics Assessment Framework"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.1.2"
  } ]
