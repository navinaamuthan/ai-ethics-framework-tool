}, {
  "@id" : "https://w3id.org/aief/AIAAIC_071",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/aief/Incident"
  } ],
  "https://w3id.org/aief/aiCapability" : [ {
    "@value" : "Reasoning (Risk Scoring)"
  } ],
  "https://w3id.org/aief/demonstratesRisk" : [ {
    "@id" : "https://w3id.org/aief/Discrimination"
  }, {
    "@id" : "https://w3id.org/aief/PrivacyBreach"
  } ],
  "https://w3id.org/aief/impactsRight" : [ {
    "@id" : "https://w3id.org/aief/Art21_NonDiscrimination"
  }, {
    "@id" : "https://w3id.org/aief/Art48_PresumptionOfInnocence"
  }, {
    "@id" : "https://w3id.org/aief/Art8_DataProtection"
  } ],
  "https://w3id.org/aief/incidentID" : [ {
    "@value" : "AIAAIC-071"
  } ],
  "https://w3id.org/aief/incidentTitle" : [ {
    "@value" : "SyRI Welfare Fraud Detection System Ruled Unlawful (Netherlands)"
  } ],
  "https://w3id.org/aief/incidentYear" : [ {
    "@value" : "2020"
  } ],
  "https://w3id.org/aief/noteText" : [ {
    "@value" : "The Hague District Court (NJCM c.s. v. The Netherlands, ECLI:NL:RBDHA:2020:1878) ruled the System Risk Indication (SyRI) algorithm, used to flag welfare recipients as fraud-risk suspects on unspecified profiling criteria, violated Article 8 ECHR, in part because opaque risk-flagging of citizens as suspects prior to any finding of wrongdoing was incompatible with a fair balance between fraud prevention and privacy/non-discrimination rights."
  } ]
}, {
  "@id" : "https://w3id.org/aief/AIAAIC_072",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/aief/Incident"
  } ],
  "https://w3id.org/aief/aiCapability" : [ {
    "@value" : "Reasoning (Predictive Policing)"
  } ],
  "https://w3id.org/aief/demonstratesRisk" : [ {
    "@id" : "https://w3id.org/aief/Discrimination"
  } ],
  "https://w3id.org/aief/impactsRight" : [ {
    "@id" : "https://w3id.org/aief/Art21_NonDiscrimination"
  }, {
    "@id" : "https://w3id.org/aief/Art48_PresumptionOfInnocence"
  }, {
    "@id" : "https://w3id.org/aief/Art6_RightToLiberty"
  } ],
  "https://w3id.org/aief/incidentID" : [ {
    "@value" : "AIAAIC-072"
  } ],
  "https://w3id.org/aief/incidentTitle" : [ {
    "@value" : "Predictive Policing Programs Discontinued After Bias Findings (US)"
  } ],
  "https://w3id.org/aief/incidentYear" : [ {
    "@value" : "2020"
  } ],
  "https://w3id.org/aief/noteText" : [ {
    "@value" : "Multiple US police departments (including LAPD's PredPol/PredCrime deployment) discontinued place-based and person-based predictive policing programs following independent audits and investigative reporting finding the underlying arrest data reproduced historical over-policing of minority neighbourhoods, treating past policing intensity as a proxy for future criminality prior to any individualised suspicion."
  } ]
}, {
  "@id" : "https://w3id.org/aief/AIAAIC_073",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/aief/Incident"
  } ],
  "https://w3id.org/aief/aiCapability" : [ {
    "@value" : "Reasoning (NLP Classification)"
  } ],
  "https://w3id.org/aief/demonstratesRisk" : [ {
    "@id" : "https://w3id.org/aief/Discrimination"
  } ],
  "https://w3id.org/aief/impactsRight" : [ {
    "@id" : "https://w3id.org/aief/Art13_FreedomOfArtsScience"
  }, {
    "@id" : "https://w3id.org/aief/Art21_NonDiscrimination"
  } ],
  "https://w3id.org/aief/incidentID" : [ {
    "@value" : "AIAAIC-073"
  } ],
  "https://w3id.org/aief/incidentTitle" : [ {
    "@value" : "AI-Detection Tools Falsely Flag Non-Native English Academic Writing"
  } ],
  "https://w3id.org/aief/incidentYear" : [ {
    "@value" : "2023"
  } ],
  "https://w3id.org/aief/noteText" : [ {
    "@value" : "Liang et al. (2023, arXiv:2304.02819) found widely-deployed GPT-detection tools misclassified over half of TOEFL essays by non-native English writers as AI-generated, with universities using such tools for academic-integrity enforcement; students and researchers face restricted ability to pursue academic work under suspicion generated by an unaudited classifier, directly implicating the freedom to conduct academic research (Art 13)."
  } ]
}, {
  "@id" : "https://w3id.org/aief/AIDeployer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
